parameters:
    level: 6
    paths:
        - app
        - src
        - tests
        - features
        - bootstrap.php
        - web/index.php
    bootstrapFiles:
        - tests/bootstrap.php
    scanFiles:
        - vendor/gridonic/princexml-php/lib/prince.php
    excludePaths:
        - tests/Event/Productions/SimilarEventsRepositoryTest.php
        - tests/Http/Productions/SuggestProductionRequestHandlerTest.php
        - tests/Offer/Commands/Moderation/AbstractModerationCommandTestBase.php
    ignoreErrors:
        - identifier: missingType.iterableValue
        # Reported since phpstan 2, to be fixed one group at a time
        - identifier: argument.type
        - identifier: arrayFilter.same
        - identifier: arrayValues.list
        - identifier: class.serializable
        - identifier: function.alreadyNarrowedType
        - identifier: instanceof.alwaysTrue
        - identifier: method.alreadyNarrowedType
        - identifier: method.nonObject
        - identifier: method.unused
        - identifier: new.resultUnused
        - identifier: notIdentical.alwaysTrue
        - identifier: property.unusedType
        - identifier: return.unusedType
        - identifier: staticMethod.alreadyNarrowedType
        # culturefeed-php documents the id as a string, but createFromXML fills it with xpath_int
        - '#^Property CultureFeed_Uitpas_DistributionKey::\$id \(string\) does not accept int\.$#'

services:
    -
        class: CultuurNet\UDB3\Phpstan\ForbiddenRamseyNamespaceRule
        tags: [phpstan.rules.rule]
